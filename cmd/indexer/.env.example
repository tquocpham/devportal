# Absolute path to the root of the Unreal project you want to index
PROJECT_PATH=/path/to/your/unreal-project

# Postgres connection string (Supabase or otherwise) with the pgvector extension available.
# For local Docker Postgres (see docker-compose.yml at the repo root), add
# ?sslmode=disable: the local container doesn't have SSL configured.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/indexer?sslmode=disable

# Which embedding provider to use: "voyage" (default, recommended: code-tuned,
# free tier covers this project) or "openai" (no free tier, ~$0.02/M tokens)
EMBEDDING_PROVIDER=voyage

# Required if EMBEDDING_PROVIDER=voyage; get one at https://dash.voyageai.com
VOYAGE_API_KEY=pa-...

# Required if EMBEDDING_PROVIDER=openai instead
# OPENAI_API_KEY=sk-...

# Optional: stop the run once cumulative embedding tokens reach this many
# (guards against runaway spend). Defaults to just under Voyage's 200M/month
# free tier when EMBEDDING_PROVIDER=voyage, or unlimited for openai. Only
# guards a single run; set explicitly to override either default.
# MAX_EMBEDDING_TOKENS=190000000
